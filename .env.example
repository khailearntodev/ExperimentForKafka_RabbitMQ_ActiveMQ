# Server Port
PORT=3000

# Broker Type: rabbitmq | activemq | kafka
MQ_TYPE=rabbitmq

# RabbitMQ Config
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=order.exchange
RABBITMQ_QUEUE=payment.queue
RABBITMQ_ROUTING_KEY=order.created

# ActiveMQ Config
ACTIVEMQ_HOST=localhost
ACTIVEMQ_PORT=61613
ACTIVEMQ_LOGIN=admin
ACTIVEMQ_PASSCODE=admin
ACTIVEMQ_QUEUE=/queue/payment.queue

# Kafka Config
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=techlab-mq-poc
KAFKA_TOPIC=order.created
KAFKA_GROUP_ID=payment-worker-group

# Payment Worker Config
# PAYMENT_DELAY_MS: 0 for Test 1, 3000 for Test 2
PAYMENT_DELAY_MS=0
# PAYMENT_FAILURE_MODE: none | retry_test (fails first 2 attempts, succeeds on 3rd)
PAYMENT_FAILURE_MODE=none
PAYMENT_MAX_RETRIES=3

# Synchronous Baseline Config (for Test 2 comparison)
SYNC_ORDER_PORT=3000
SYNC_PAYMENT_PORT=3001
SYNC_PAYMENT_URL=http://localhost:3001/process-payment
